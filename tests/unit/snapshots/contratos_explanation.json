    "type": "string"
   },
   "EstadoIntegridade": {
    "enum": [
     "OK",
     "QUARENTENA_TRUNCADO",
     "QUARENTENA_CHECKSUM",
     "QUARENTENA_CONTEUDO_INESPERADO",
     "QUARENTENA_LEIAUTE",
     "QUARENTENA_CAMINHO_INSEGURO",
     "NAO_VERIFICADO"
    ],
    "title": "EstadoIntegridade",
    "type": "string"
   },
   "EstadoSelecao": {
    "enum": [
     "SELECIONADA",
