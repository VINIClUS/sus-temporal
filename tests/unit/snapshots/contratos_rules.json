    "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
    "title": "Run Id",
    "type": "string"
   },
   "selecoes": {
    "default": [],
    "items": {
     "$ref": "#/$defs/SelecaoVersao"
    },
    "title": "Selecoes",
    "type": "array"
   },
   "versao": {
    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
    "title": "Versao",
    "type": "string"
   }
