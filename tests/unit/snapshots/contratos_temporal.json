   },
   "CanalPublicacao": {
    "enum": [
     "ATUAL",
     "PRELIMINAR",
     "HISTORICO",
     "IMPORTACAO_MANUAL",
     "DESCONHECIDO"
    ],
    "title": "CanalPublicacao",
    "type": "string"
   },
   "FamiliaFonte": {
    "enum": [
     "SIA_PA",
     "CNES_ST",
     "CNES_PF",
     "CNES_SR",
     "CNES_HB",
     "SIGTAP",
     "TERRITORIO_DRS",
     "DOCUMENTO"
    ],
    "title": "FamiliaFonte",
    "type": "string"
   }
  },
  "additionalProperties": false,
  "properties": {
   "base": {
    "$ref": "#/$defs/BaseTemporal"
   },
   "canal": {
