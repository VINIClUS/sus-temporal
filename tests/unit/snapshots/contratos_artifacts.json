   },
   "metadados_remotos": {
    "$ref": "#/$defs/MetadadosRemotos"
   },
   "observado_em": {
    "format": "date-time",
    "title": "Observado Em",
    "type": "string"
   },
   "observation_id": {
    "pattern": "^obs_[0-9a-f]{32,64}$",
    "title": "Observation Id",
    "type": "string"
   },
   "request_sha256": {
    "pattern": "^[0-9a-f]{64}$",
