    },
    "required": [
     "doc_id",
     "titulo",
     "estado",
     "proveniencia"
    ],
    "title": "DocRef",
    "type": "object"
   },
   "EstadoDocumento": {
    "enum": [
     "PRESERVADO",
     "PENDENTE"
    ],
    "title": "EstadoDocumento",
    "type": "string"
   },
   "EstadoRegra": {
    "enum": [
     "CANDIDATA_PRE_G0",
     "APROVADA_G0",
     "CONGELADA",
     "RETIRADA"
