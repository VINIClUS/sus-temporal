{
 "Afirmacao": {
  "additionalProperties": false,
  "properties": {
   "referencias": {
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "title": "Referencias",
    "type": "array"
   },
   "template_id": {
    "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
    "title": "Template Id",
    "type": "string"
   },
   "texto": {
    "minLength": 1,
    "title": "Texto",
    "type": "string"
   }
  },
  "required": [
   "texto",
   "template_id",
   "referencias"
  ],
  "title": "Afirmacao",
  "type": "object"
 },
 "Evidence": {
  "$defs": {
   "EstadoCobertura": {
    "enum": [
     "DISPONIVEL",
     "INSUFICIENTE",
     "AUSENTE"
    ],
    "title": "EstadoCobertura",
    "type": "string"
   },
   "EstadoIntegridade": {
    "enum": [
     "OK",
     "QUARENTENA_TRUNCADO",
     "QUARENTENA_CHECKSUM",
     "QUARENTENA_CONTEUDO_INESPERADO",
     "QUARENTENA_LEIAUTE",
     "QUARENTENA_CAMINHO_INSEGURO",
     "NAO_VERIFICADO"
    ],
    "title": "EstadoIntegridade",
    "type": "string"
   },
   "TipoEvidencia": {
    "enum": [
     "VINCULO_ENCONTRADO",
     "AUSENCIA_NA_FONTE",
     "FONTE_INCOMPLETA",
     "APLICABILIDADE",
     "SELECAO_TEMPORAL"
    ],
    "title": "TipoEvidencia",
    "type": "string"
   }
  },
  "additionalProperties": false,
  "properties": {
   "artifact_ids": {
    "items": {
     "pattern": "^art_[0-9a-f]{64}$",
     "type": "string"
    },
    "title": "Artifact Ids",
    "type": "array"
   },
   "chaves_amostra": {
    "default": [],
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "title": "Chaves Amostra",
    "type": "array"
   },
   "cobertura": {
    "$ref": "#/$defs/EstadoCobertura"
   },
   "dataset_id": {
    "pattern": "^ds_[0-9a-f]{64}$",
    "title": "Dataset Id",
    "type": "string"
   },
   "evidence_id": {
    "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
    "title": "Evidence Id",
    "type": "string"
   },
   "hash_logico": {
    "pattern": "^lh1:[0-9a-f]{64}$",
    "title": "Hash Logico",
    "type": "string"
   },
   "integridade": {
    "$ref": "#/$defs/EstadoIntegridade"
   },
   "n_resultados": {
    "ge": 0,
    "title": "N Resultados",
    "type": "integer"
   },
   "parametros": {
    "additionalProperties": {
     "type": "string"
    },
    "title": "Parametros",
    "type": "object"
   },
   "query_id": {
    "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
    "title": "Query Id",
    "type": "string"
   },
   "sql_sha256": {
    "pattern": "^[0-9a-f]{64}$",
    "title": "Sql Sha256",
    "type": "string"
   },
   "tipo": {
    "$ref": "#/$defs/TipoEvidencia"
   }
  },
  "required": [
   "evidence_id",
   "tipo",
   "query_id",
   "sql_sha256",
   "dataset_id",
   "hash_logico",
   "artifact_ids",
   "cobertura",
   "integridade",
   "n_resultados"
  ],
  "title": "Evidence",
  "type": "object"
 },
 "ExplanationBundle": {
