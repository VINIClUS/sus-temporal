      "items": {
       "type": "string"
      },
      "title": "Instrumentos",
      "type": "array"
     },
     "referencia": {
      "$ref": "#/$defs/DocRef"
     },
     "requisitos_fonte": {
      "items": {
       "$ref": "#/$defs/RequisitoFonte"
      },
      "minItems": 1,
      "title": "Requisitos Fonte",
      "type": "array"
     },
     "unidade_avaliacao": {
      "$ref": "#/$defs/UnidadeAvaliacao"
     }
    },
    "required": [
     "familia",
     "estado",
     "descricao",
     "instrumentos",
     "unidade_avaliacao",
     "requisitos_fonte",
     "referencia"
    ],
    "title": "FamiliaCandidata",
    "type": "object"
   },
   "FamiliaFonte": {
    "enum": [
     "SIA_PA",
     "CNES_ST",
     "CNES_PF",
     "CNES_SR",
     "CNES_HB",
     "SIGTAP",
     "TERRITORIO_DRS",
     "DOCUMENTO"
    ],
    "title": "FamiliaFonte",
    "type": "string"
   },
   "FamiliaRegra": {
    "enum": [
     "PROCEDIMENTO_CBO",
     "ESTABELECIMENTO_CBO",
     "INSTRUMENTO_REGISTRO",
     "VIGENCIA_PROCEDIMENTO",
     "SERVICO_CLASSIFICACAO",
     "HABILITACAO",
     "CID",
     "IDADE",
     "SEXO",
     "QUANTIDADE_MAXIMA"
    ],
    "title": "FamiliaRegra",
    "type": "string"
   },
   "Proveniencia": {
    "enum": [
     "OFICIAL_DOCUMENTO",
     "OFICIAL_ARQUIVO",
     "OFICIAL_VISTO_EM_BUSCA",
     "SECUNDARIA",
     "INFERIDA",
     "INFERIDA_PILOTO"
    ],
    "title": "Proveniencia",
    "type": "string"
   },
   "RequisitoFonte": {
    "additionalProperties": false,
    "properties": {
     "campos": {
      "items": {
       "type": "string"
      },
      "title": "Campos",
      "type": "array"
     },
     "fonte": {
      "$ref": "#/$defs/FamiliaFonte"
     },
     "schema_id": {
      "pattern": "^[a-z0-9_]+\\.v[0-9]+$",
      "title": "Schema Id",
      "type": "string"
     }
    },
    "required": [
     "fonte",
     "schema_id",
     "campos"
    ],
    "title": "RequisitoFonte",
    "type": "object"
   },
   "UnidadeAvaliacao": {
    "enum": [
     "OCORRENCIA",
     "ESTABELECIMENTO_CBO"
    ],
    "title": "UnidadeAvaliacao",
    "type": "string"
   }
  },
  "additionalProperties": false,
  "properties": {
   "familias": {
    "items": {
     "$ref": "#/$defs/FamiliaCandidata"
    },
    "title": "Familias",
    "type": "array"
   },
   "reservadas": {
    "default": [],
    "items": {
     "$ref": "#/$defs/FamiliaRegra"
    },
    "title": "Reservadas",
    "type": "array"
   },
   "versao": {
    "title": "Versao",
    "type": "string"
   }
  },
  "required": [
   "versao",
   "familias"
  ],
  "title": "CatalogoFamilias",
  "type": "object"
 },
 "FalhaOperacional": {
  "additionalProperties": false,
  "properties": {
   "erro": {
