      "$ref": "#/$defs/CanalPublicacao"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "deslocamento_meses": {
    "default": 0,
    "title": "Deslocamento Meses",
    "type": "integer"
   },
   "fonte": {
    "$ref": "#/$defs/FamiliaFonte"
   }
