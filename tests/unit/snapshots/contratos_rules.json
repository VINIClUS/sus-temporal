   "ResultadoRegistro": {
    "enum": [
     "ALERTA",
     "SEM_VIOLACAO_VERIFICADA",
     "ABSTENCAO"
    ],
    "title": "ResultadoRegistro",
    "type": "string"
   }
  },
  "additionalProperties": false,
  "properties": {
   "conformes": {
    "default": [],
    "items": {
     "type": "string"
    },
    "title": "Conformes",
    "type": "array"
   },
   "inconclusivas": {
    "default": [],
    "items": {
     "type": "string"
    },
    "title": "Inconclusivas",
    "type": "array"
   },
   "nao_aplicaveis": {
    "default": [],
    "items": {
     "type": "string"
    },
    "title": "Nao Aplicaveis",
    "type": "array"
   },
   "resultado": {
    "$ref": "#/$defs/ResultadoRegistro"
   },
   "row_id": {
    "pattern": "^art_[0-9a-f]{64}(/[^#\\s]+)?#[0-9]+$",
    "title": "Row Id",
    "type": "string"
   },
   "violacoes": {
    "default": [],
    "items": {
     "type": "string"
    },
    "title": "Violacoes",
    "type": "array"
   }
  },
  "required": [
   "row_id",
   "resultado"
  ],
  "title": "AgregadoRegistro",
  "type": "object"
 },
 "CatalogoFamilias": {
  "$defs": {
   "Confirmacao": {
    "enum": [
     "CONFIRMADO",
     "A_CONFIRMAR"
    ],
    "title": "Confirmacao",
    "type": "string"
   },
   "DocRef": {
    "additionalProperties": false,
    "properties": {
     "confirmacao": {
      "$ref": "#/$defs/Confirmacao",
      "default": "A_CONFIRMAR"
     },
     "doc_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "title": "Doc Id",
      "type": "string"
     },
     "estado": {
      "$ref": "#/$defs/EstadoDocumento"
     },
     "localizador": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Localizador"
     },
     "proveniencia": {
      "$ref": "#/$defs/Proveniencia"
     },
     "sha256": {
      "anyOf": [
       {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Sha256"
     },
     "titulo": {
      "title": "Titulo",
      "type": "string"
     },
     "trecho": {
      "anyOf": [
       {
        "maxLength": 400,
