     "uf": {
      "anyOf": [
       {
        "pattern": "^[A-Z]{2}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Uf"
     },
     "versao_publicacao": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
